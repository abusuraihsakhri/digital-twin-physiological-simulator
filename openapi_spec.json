{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Twin Physiological Simulator API",
    "description": "Local research demonstration of fixed numeric thresholds and descriptor rules; not a validated physiological or clinical model.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Get local in-memory task counts as JSON",
        "responses": {
          "200": {
            "description": "JSON operational counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate deterministic demonstration rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule dossier with in-memory HMAC audit-chain entry"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query the deterministic mock responder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response; not an LLM"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Current process's in-memory HMAC chain (not persisted)"
          }
        }
      }
    }
  }
}
